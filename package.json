{
  "name": "taller-agentes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run tipos && npm test",
    "cobertura": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "arquitectura": "depcruise src --config .dependency-cruiser.cjs",
    "duplicado": "jscpd src tests scripts --format typescript,tsx,javascript --ignore \"**/node_modules/**,scripts/puertas/**\" --reporters json --output reports/jscpd --silent",
    "muerto": "mkdir -p reports && knip --reporter json --no-exit-code > reports/knip.json",
    "puertas": "BASE=$(git rev-parse --verify --quiet origin/main || git rev-list --max-parents=0 HEAD | tail -n 1) && node scripts/puertas/guarda-umbrales.mjs --base \"$BASE\" && node scripts/puertas/detector-manipulacion.mjs --base \"$BASE\" && npm run duplicado && npm run muerto && node scripts/puertas/trinquete.mjs --base \"$BASE\"",
    "spec:check": "node scripts/puertas/spec-check.mjs --specs docs/SPEC.md,DIRECTRICES.md --vitest reports/vitest.json",
    "check:full": "npm run check && npm run cobertura && npm run arquitectura && npm run puertas && npm run spec:check",
    "gate:tipos": "npm run tipos",
    "gate:rls": "vitest run tests/bd",
    "gate:mutacion": "stryker run --concurrency 4",
    "e2e": "playwright test tests/e2e/movil.spec.ts",
    "gate:e2e": "npm run e2e",
    "gate:a11y": "npm run e2e",
    "gate:cabeceras": "vitest run tests/seguridad/cabeceras.test.ts",
    "smoke": "playwright test tests/e2e/smoke.spec.ts",
    "checklist": "node scripts/checklist-entrega.mjs",
    "desplegar": "npx vercel@65.16.0 pull --yes --environment=production && npx vercel@65.16.0 build --prod && npx vercel@65.16.0 deploy --prebuilt --prod"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.6.0",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.9.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-check": "4.11.0",
    "jscpd": "5.4.3",
    "jsdom": "31.0.1",
    "knip": "6.48.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "11.0.9"
    },
    "eslint-plugin-sonarjs": {
      "minimatch": "11.0.9",
      "eslint": {
        "minimatch": "^3.1.5"
      }
    }
  }
}
